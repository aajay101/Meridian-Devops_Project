
# =========================================================
# MERIDIAN ENVIRONMENT CONFIGURATION
# =========================================================

# =========================================================
# APPLICATION
# =========================================================

APP_ENV=development
PORT=8000
SECRET_KEY=replace-with-a-random-secret-key
SESSION_COOKIE_SECURE=false

# =========================================================
# POSTGRESQL
# =========================================================

# Native/local PostgreSQL defaults.
# Docker Compose overrides DB_HOST and DB_PORT for containers.
DB_HOST=127.0.0.1
DB_PORT=5434

# Development database
DEV_DB_NAME=meridian_dev
DEV_DB_USER=meridian_dev_user
DEV_DB_PASSWORD=replace-with-dev-db-password

# Testing database
TEST_DB_NAME=meridian_test
TEST_DB_USER=meridian_test_user
TEST_DB_PASSWORD=replace-with-test-db-password

# Production database
PROD_DB_NAME=meridian_prod
PROD_DB_USER=meridian_prod_user
PROD_DB_PASSWORD=replace-with-prod-db-password

# Docker PostgreSQL administrator
POSTGRES_ADMIN_USER=meridian_docker_admin
POSTGRES_ADMIN_PASSWORD=replace-with-a-strong-password

# =========================================================
# REDIS
# =========================================================

# Redis DB 0: Celery broker and result backend
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/0

# Redis DB 1: Flask caching
CACHE_REDIS_URL=redis://localhost:6380/1

CACHE_DEFAULT_TIMEOUT=300
REDIS_FAILURE_COOLDOWN=30

# =========================================================
# CELERY SCHEDULING
# =========================================================

CELERY_TIMEZONE=Asia/Kolkata

REMINDER_WINDOW_DAYS=3
REMINDER_HOUR=8
REMINDER_MINUTE=0

REPORT_HOUR=6
REPORT_MINUTE=0

# =========================================================
# EMAIL CONFIGURATION
# =========================================================

MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true

# =========================================================
# ADMINISTRATOR
# =========================================================

ADMIN_EMAIL=admin@placement.local
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# =========================================================
# APPLICATION URL
# =========================================================

APP_BASE_URL=http://localhost:5173

# =========================================================
# BUSINESS RULES
# =========================================================

MAX_ACTIVE_OFFERS=3
